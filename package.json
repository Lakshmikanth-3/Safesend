{
  "name": "thunai",
  "private": true,
  "version": "1.0.0",
  "description": "SafeSend: safer crypto payments for people new to crypto, with a trusted family member reviewing risky transfers. Built on Monad.",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "contracts:deploy": "node scripts/deploy.mjs",
    "abi": "node scripts/sync-abis.mjs",
    "relayer": "pnpm --filter @thunai/relayer dev",
    "agent": "pnpm --filter @thunai/agent dev",
    "app": "pnpm --filter @thunai/app start",
    "dev": "node scripts/dev.mjs",
    "web:build": "node scripts/build-web.mjs",
    "web:dev": "node scripts/build-web.mjs --dev",
    "test": "pnpm -r test",
    "parity": "node scripts/check-parity.mjs",
    "e2e": "tsx scripts/e2e.mjs",
    "e2e:testnet": "tsx scripts/e2e-testnet.mjs",
    "verify": "pnpm contracts:test && pnpm parity && pnpm typecheck && pnpm e2e",
    "typecheck": "pnpm -r typecheck",
    "api:build": "node scripts/build-api-vercel.mjs"
  },
  "devDependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "ajv": "8.20.0",
    "esbuild": "0.24.2",
    "tsx": "^4.21.1",
    "typescript": "^5.9.2",
    "viem": "^2.55.10",
    "yaml": "^2.8.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react-native-worklets": "*",
        "@react-native/metro-config": "*"
      }
    }
  }
}
